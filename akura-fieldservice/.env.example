AKURA_FIELDSERVICE_PUBLIC_URL=http://localhost:4177
VITE_AKURA_SHELL_URL=http://localhost:4173

# Development direct access to the local Field Service backend (no local gateway).
VITE_API_BASE_URL=http://localhost:5005
# Auth refresh/profile still uses the gateway that issued the session cookie.
VITE_AUTH_BASE_URL=https://akura-api-gateway.vercel.app/api/v1

# On Vercel, omit VITE_API_BASE_URL (or set /api/v1) so requests use the
# same-origin gateway; VITE_AUTH_BASE_URL can also be omitted then.
# VITE_API_BASE_URL=/api/v1

