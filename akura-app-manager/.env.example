VITE_AKURA_SHELL_URL=http://localhost:4173
# Auth always uses the gateway that issued the session cookie.
VITE_AUTH_BASE_URL=https://akura-api-gateway.vercel.app/api/v1
# Optional direct local App Manager. Also configure this in the Shell.
# Use the service root: the client removes /app-manager from local requests.
# VITE_APP_MANAGER_BASE_URL=http://localhost:5002
# Legacy VITE_API_BASE_URL still configures the gateway when used alone.
# In production, omit API overrides (or set /api/v1).
