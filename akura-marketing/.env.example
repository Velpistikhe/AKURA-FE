AKURA_MARKETING_PUBLIC_URL=http://localhost:4175
VITE_AKURA_SHELL_URL=http://localhost:4173
# Direct local service roots; the client removes the service prefix.
VITE_MARKETING_BASE_URL=http://localhost:5003
VITE_FIELDSERVICE_BASE_URL=http://localhost:5005
# Auth and internal requests always use the issuing gateway.
VITE_AUTH_BASE_URL=https://akura-api-gateway.vercel.app/api/v1
# To use a gateway for domain requests, set that base URL including /api/v1.
# In production, omit API overrides (or set /api/v1).
